<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FSG_PushbackCreator.Models"
             x:Class="FSG_PushbackCreator.Pages.AirportListPage"
             Title="Airports">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
          Padding="16"
          RowSpacing="12"
          MaximumWidthRequest="1194"
          HorizontalOptions="Center">

        <Label Grid.Row="0"
               Text="Airports in this project. A dummy pushback airport needs a helipad or it will not show in FSG / FS4."
               Style="{StaticResource SubHeadline}" />

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="Project package name (folder inside the TME/ZIP)"
                   Style="{StaticResource FieldCaption}" />
            <Entry x:Name="PackageNameEntry"
                   Placeholder="pca_scenery_pushback"
                   MaxLength="64"
                   Unfocused="OnPackageNameUnfocused" />
        </VerticalStackLayout>

        <Button Grid.Row="2"
                Text="New"
                Clicked="OnNewAirport"
                HorizontalOptions="Start" />

        <CollectionView x:Name="AirportList"
                        Grid.Row="3"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No airports yet. Use New to add a pushback airport or a heliport."
                       Margin="0,24,0,0" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AirportEntry">
                    <VerticalStackLayout Padding="0,6" Spacing="4">
                        <Label Text="{Binding ListSummary}" LineBreakMode="TailTruncation" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Text="Edit" Clicked="OnEdit" CommandParameter="{Binding .}" />
                            <Button Grid.Column="1"
                                    Text="Delete"
                                    Style="{StaticResource QuietButton}"
                                    Clicked="OnDelete"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="4" Spacing="8" Padding="0,8,0,0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Export TME" Clicked="OnExportTme" />
                <Button Grid.Column="1" Text="Export ZIP (FS4)" Clicked="OnExportZip" />
            </Grid>
            <Button Text="Cancel"
                    Style="{StaticResource QuietButton}"
                    Clicked="OnCancel"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
