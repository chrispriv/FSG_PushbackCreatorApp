<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:FSG_PushbackCreator.Services"
             x:Class="FSG_PushbackCreator.Pages.AirportEditPage"
             Title="Airport"
             Shell.NavBarIsVisible="False"
             Padding="16"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid x:Name="MainGrid" ColumnSpacing="12" RowSpacing="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="FormPanel" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollView>
                <VerticalStackLayout Spacing="8" Padding="0,0,12,8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Button Text="←"
                                Style="{StaticResource QuietButton}"
                                WidthRequest="36"
                                Padding="0"
                                Clicked="OnCancel" />
                        <Label x:Name="KindLabel"
                               Grid.Column="1"
                               Style="{StaticResource SubHeadline}"
                               LineBreakMode="NoWrap"
                               VerticalOptions="Center" />
                    </Grid>

                    <Grid x:Name="IdentityGrid"
                          ColumnDefinitions="*,1.25*"
                          ColumnSpacing="12">
                        <VerticalStackLayout x:Name="IcaoBlock" Spacing="0">
                            <Label x:Name="IcaoCaptionLabel"
                                   Text="ICAO (4 chars)"
                                   Style="{StaticResource FieldCaption}"
                                   LineBreakMode="NoWrap" />
                            <Entry x:Name="IcaoEntry"
                                   MaxLength="4"
                                   Placeholder="e.g. UBBN or CH99"
                                   Keyboard="Text"
                                   TextChanged="OnIcaoChanged" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="NameBlock" Grid.Column="1" Spacing="0">
                            <Label x:Name="NameCaptionLabel" Style="{StaticResource FieldCaption}" />
                            <Entry x:Name="NameEntry"
                                   MaxLength="32"
                                   Placeholder="Optional. Empty uses the TME code."
                                   Keyboard="Text" />
                        </VerticalStackLayout>
                    </Grid>

                    <Border x:Name="SearchPanel"
                            Stroke="#333333"
                            StrokeThickness="1"
                            BackgroundColor="{StaticResource ChromeBackground}"
                            Padding="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Find location (OpenStreetMap)" Style="{StaticResource FieldCaption}" Margin="0" />
                            <Label Text="Use this when the airport has no coordinates yet. Search, pick a result, then tap the map to place the selected object."
                                   FontSize="12"
                                   TextColor="{StaticResource TextDim}"
                                   LineBreakMode="WordWrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Entry x:Name="SearchEntry"
                                       Placeholder="Airport name or ICAO"
                                       Keyboard="Text"
                                       ReturnType="Search"
                                       Completed="OnSearchCompleted" />
                                <Button Text="Search"
                                        Style="{StaticResource QuietButton}"
                                        Clicked="OnSearchClicked"
                                        Grid.Column="1" />
                            </Grid>
                            <Label x:Name="SearchStatusLabel"
                                   FontSize="12"
                                   TextColor="{StaticResource TextDim}" />
                            <CollectionView x:Name="SearchList"
                                            IsVisible="False"
                                            HeightRequest="110"
                                            SelectionMode="Single"
                                            SelectionChanged="OnSearchSelectionChanged">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="services:NominatimHit">
                                        <Label Text="{Binding ListSummary}"
                                               FontSize="12"
                                               LineBreakMode="TailTruncation"
                                               Padding="0,6" />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Map objects" Style="{StaticResource FieldCaption}" />
                    <Grid x:Name="ParkingToolbar" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="NewParkingButton"
                                Text="New parking slot"
                                Clicked="OnNewParking" />
                        <Button x:Name="SortParkingButton"
                                Grid.Column="1"
                                Text="Sort A–Z"
                                Style="{StaticResource QuietButton}"
                                Clicked="OnSortParking" />
                    </Grid>
                    <Label x:Name="ParkingHintLabel" FontSize="12" TextColor="{StaticResource TextDim}" />
                    <CollectionView x:Name="ObjectList"
                                    SelectionMode="Single"
                                    HeightRequest="150"
                                    SelectionChanged="OnObjectSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="services:MapObjectRow">
                                <Label Text="{Binding Title}"
                                       LineBreakMode="TailTruncation"
                                       Padding="0,6" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout x:Name="HelipadInspector" Spacing="0">
                        <Label Text="Helipad position (tap map, drag, or paste decimal)"
                               Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="HelipadPositionEntry"
                               Placeholder="40.4675, 50.0539"
                               Keyboard="Text"
                               Unfocused="OnHelipadFieldsChanged" />
                        <Label Text="Helipad heading (deg), default 0"
                               Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="HelipadHeadingEntry"
                               Keyboard="Numeric"
                               Unfocused="OnHelipadFieldsChanged" />
                        <VerticalStackLayout x:Name="HeliportObjectsSection" Spacing="0">
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox x:Name="DummyHelipadCheck" VerticalOptions="Center" />
                                <Label Text="Add helipad object"
                                       Style="{StaticResource FieldCaption}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Helipad height offset m (optional, 0 = default)"
                                   Style="{StaticResource FieldCaption}" />
                            <Entry x:Name="HelipadHeightOffsetEntry"
                                   Placeholder="0"
                                   Keyboard="Numeric" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="TowerInspector" Spacing="0" IsVisible="False">
                        <Label Text="Tower position shift (optional; tap map or paste decimal)"
                               Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="TowerPositionEntry"
                               Placeholder="Optional. Empty = no tower shift."
                               Keyboard="Text"
                               Unfocused="OnTowerFieldsChanged" />
                        <Label Text="Tower height AGL m (optional, 0 = default)"
                               Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="TowerHeightEntry"
                               Placeholder="0"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="WindsockInspector" Spacing="0" IsVisible="False">
                        <Label Text="Windsock (optional; tap map or paste decimal)"
                               Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="WindsockPositionEntry"
                               Placeholder="Optional. Empty = no windsock."
                               Keyboard="Text"
                               Unfocused="OnWindsockFieldsChanged" />
                        <Label Text="Height offset m (optional, 0 = default)"
                               Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="WindsockHeightEntry"
                               Placeholder="0"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="ParkingInspector" Spacing="0" IsVisible="False">
                        <Label Text="Parking name (gate), e.g. A1" Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="ParkingNameEntry"
                               Placeholder="A1"
                               Unfocused="OnParkingFieldsChanged" />
                        <Label Text="Parking position (tap map, drag, or paste decimal)"
                               Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="ParkingPositionEntry"
                               Placeholder="40.4675, 50.0539"
                               Keyboard="Text"
                               Unfocused="OnParkingFieldsChanged" />
                        <Label Text="Parking heading (deg), default 0" Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="ParkingHeadingEntry"
                               Keyboard="Numeric"
                               Unfocused="OnParkingFieldsChanged" />
                        <Label Text="Parking size, default 35" Style="{StaticResource FieldCaption}" />
                        <Entry x:Name="ParkingSizeEntry"
                               Keyboard="Numeric"
                               Unfocused="OnParkingFieldsChanged" />
                        <Button Text="Delete parking slot"
                                Style="{StaticResource QuietButton}"
                                Clicked="OnDeleteSelectedParking" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Save" Clicked="OnSave" />
                <Button Grid.Column="1"
                        Text="Cancel"
                        Style="{StaticResource QuietButton}"
                        Clicked="OnCancel" />
            </Grid>
        </Grid>

        <Border x:Name="MapPanel"
                Grid.Column="1"
                Stroke="#333333"
                StrokeThickness="1"
                BackgroundColor="{StaticResource PageBackground}">
            <HybridWebView x:Name="MapView"
                           HybridRoot="wwwroot"
                           DefaultFile="index.html"
                           RawMessageReceived="OnMapMessage" />
        </Border>
    </Grid>
</ContentPage>
