<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette from chrispriv/aeroscenery-afs_addons assets/css/style.css (always-dark GitHub Pages). -->
    <Color x:Key="PageBackground">#111111</Color>
    <Color x:Key="ChromeBackground">#1A1A1A</Color>
    <Color x:Key="CardBackground">#1B1B1B</Color>
    <Color x:Key="CardElevated">#222222</Color>
    <Color x:Key="TextPrimary">#EEEEEE</Color>
    <Color x:Key="TextMuted">#DDDDDD</Color>
    <Color x:Key="TextSubtle">#CCCCCC</Color>
    <Color x:Key="TextDim">#AAAAAA</Color>
    <Color x:Key="LinkBlue">#4DA3FF</Color>
    <Color x:Key="ButtonBlue">#0066CC</Color>
    <Color x:Key="ButtonBlueHover">#0080FF</Color>
    <Color x:Key="TagBackground">#333333</Color>

    <OnPlatform x:Key="SiteFontFamily" x:TypeArguments="x:String">
        <On Platform="WinUI" Value="Arial" />
        <On Platform="Android" Value="OpenSansRegular" />
        <On Platform="iOS" Value="Arial" />
        <On Platform="MacCatalyst" Value="Arial" />
    </OnPlatform>
    <OnPlatform x:Key="SiteFontBold" x:TypeArguments="x:String">
        <On Platform="WinUI" Value="Arial" />
        <On Platform="Android" Value="OpenSansSemibold" />
        <On Platform="iOS" Value="Arial" />
        <On Platform="MacCatalyst" Value="Arial" />
    </OnPlatform>

    <Color x:Key="Primary">#0066CC</Color>
    <Color x:Key="PrimaryDark">#4DA3FF</Color>
    <Color x:Key="PrimaryDarkText">#EEEEEE</Color>
    <Color x:Key="Secondary">#1B1B1B</Color>
    <Color x:Key="SecondaryDarkText">#4DA3FF</Color>
    <Color x:Key="Tertiary">#0080FF</Color>

    <Color x:Key="White">#EEEEEE</Color>
    <Color x:Key="Black">#111111</Color>
    <Color x:Key="Magenta">#4DA3FF</Color>
    <Color x:Key="MidnightBlue">#EEEEEE</Color>
    <Color x:Key="OffBlack">#111111</Color>

    <Color x:Key="Gray100">#EEEEEE</Color>
    <Color x:Key="Gray200">#DDDDDD</Color>
    <Color x:Key="Gray300">#CCCCCC</Color>
    <Color x:Key="Gray400">#AAAAAA</Color>
    <Color x:Key="Gray500">#888888</Color>
    <Color x:Key="Gray600">#333333</Color>
    <Color x:Key="Gray900">#1A1A1A</Color>
    <Color x:Key="Gray950">#111111</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
